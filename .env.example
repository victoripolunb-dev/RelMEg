# ---------------------------------------------------------------------------
# RELMEG — variáveis de ambiente (referência do backend)
# ---------------------------------------------------------------------------
# O backend é a forma atual de uso (Postman); frontend fora do escopo da V1.
# Copie para backend/.env (ou defina no ambiente da máquina/servidor).
#
# Observação importante do pydantic-settings (sem env_prefix, case-insensitive):
# o nome da env é derivado do NOME DO CAMPO. Campos "neutros" viram env sem
# prefixo — ex.: confiar_xff → CONFIAR_XFF; usa_scrapling → USA_SCRAPLING;
# log_level → LOG_LEVEL; dir_entregas → DIR_ENTREGAS.
# Campos que já começam com "relmeg_" ou "tse_" viram RELMEG_*/TSE_*.

# --- Autenticação de superfície (X-API-Key obrigatório em TODAS as rotas) --
# Redece para /, /docs, /redoc, /openapi.json e PREFLIGHT OPTIONS. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se vazia, a API fica aberta (somente ambiente localhost). Nunca deixe vazia
# ao expor via ngrok/túnel reverso.
# RELMEG_API_KEY=
# RELMEG_REQUER_API_KEY=false   # true + chave vazia = startup ABORTA (fail-fast)
# RELMEG_DOCS_PUBLICOS=false    # true abre /docs, /redoc e /openapi.json mesmo
#                               # com a chave ativa (apenas dev localhost)

# --- CORS (origens extras além das padrão de main.py) ------------------------
# RELMEG_CORS_ORIGINS_EXTRA=https://variante.exemplo.com.br

# --- Log / auditoria -----------------------------------------------------------
# LOG_LEVEL=INFO
# AUDITORIA_RETENCAO_DIAS=90

# --- Pasta de entregas (default: ~/Desktop/RelMeg - Entregas) ---------------
# DIR_ENTREGAS=C:\Caminho\Para\Entregas
# Subpastas temáticas de entrega (padrões abaixo):
# SUBDIR_TSE=TSE
# SUBDIR_NOVAS_PROPOSICOES=Novas proposições
# SUBDIR_RELATORIOS=Relatórios
# SUBDIR_PERFIL=Perfil
# DATA_DIR=C:\Caminho\Para\data        # dados locais (cache SQLite etc.)
# LOG_DIR=C:\Caminho\Para\logs         # logs estruturados (loguru)
# TEMPLATES_DIR=C:\Caminho\Para\templates
# MODELO_CLIPPING=C:\Caminho\MODELO A SER SEGUIDO.docx
# MODELO_BASE_TEMPLATE=C:\Caminho\MODELO BASE

# --- Rate limiting (slowapi): N=quantidade, S=segundos/M=minutos/H=horas ----
# RATELIMIT_DEFAULT=120/minute   # backstop das rotas NÃO decoradas (lido por
#                               # config.py -> rate_limit.py)
# RATELIMIT_ENABLED=true         # lido pelo próprio slowapi (não passa por
#                               # config.py); use false apenas em testes/diagnóstico
# CONFIAR_XFF=false
#   true APENAS atrás de reverse-proxy controlado (Vercel/Render/nginx), para
#   o rate limit confiar no 1º X-Forwarded-For (imune a XFF forjado por padrão).

# --- Cache local SQLite -------------------------------------------------------
# RELMEG_CACHE_DB=C:\Caminho\Para\relmeg_cache.db

# --- Hub legislativo (relmeg_core: Câmara, Senado, CLDF, DOU) ---------------
# HTTP_TIMEOUT=30
# HTTP_MAX_TENTATIVAS=3
# HTTP_BACKOFF_BASE=0.5
# HTTP_BACKOFF_JITTER=0.5
# HTTP_USER_AGENT=           # UA do navegador enviado aos portais legislativos
# USA_SCRAPLING=true
#   Fallback por raspagem (Scrapling) quando a API oficial falha/fica vazia;
#   a CLDF usa para o histórico de andamento (a API dela só expõe a etapa).
#   Tudo sob demanda (AGENTS.md) — para desligar: USA_SCRAPLING=false.
# SCRAPLING_TIMEOUT_MS=45000   # tolerância do browser headless (milissegundos)

# --- TSE (DivulgaCandContas) ---------------------------------------------------
# TSE_BASE_URL=https://divulgacandcontas.tse.jus.br/divulga/rest/v1
# TSE_PORTAL_URL=https://divulgacandcontas.tse.jus.br/divulga/
# TSE_TIMEOUT=30
# TSE_MAX_CONCURRENCY=12
# TSE_MAX_TENTATIVAS=4
# TSE_BACKOFF_BASE=1.0
# TSE_BACKOFF_JITTER=0.5
# TSE_CACHE_TTL=86400          # janela de validade do cache local (0 = desativa)
# TSE_ID_ELEICAO_2026=2055502026
# TSE_USER_AGENT=              # UA do navegador enviado à API (bloqueio/política)